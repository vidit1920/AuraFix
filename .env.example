# Copy this file to .env for local development, or set these as environment
# variables / secrets on your host (e.g. Render). NEVER commit a real .env.
#
# In the hosted app, end users paste their OWN model key and GitHub token in
# the sidebar (bring your own key), so the LLM keys below are only a
# convenience for local CLI runs and the offline tests.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "production" on your live host; anything else enables dev conveniences.
APP_ENV=development

# ---------------------------------------------------------------------------
# Authentication (Firebase) — REQUIRED in production
# ---------------------------------------------------------------------------
# For LOCAL development you can skip Firebase entirely by disabling the gate:
#   AURAFIX_AUTH_DISABLED=true     (only takes effect when APP_ENV != production)
AURAFIX_AUTH_DISABLED=true

# Public Firebase web config (safe to expose; it ships to browsers).
# Create a project at https://console.firebase.google.com, enable the Google
# and GitHub sign-in providers, then copy these from Project settings.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
# Which sign-in buttons to show (comma separated): google, github, email
FIREBASE_PROVIDERS=google,github

# Service account for SERVER-SIDE token verification. This IS a secret.
# Provide the JSON as a single-line env var (recommended on Render):
#   FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
# or point to a mounted file:
#   FIREBASE_SERVICE_ACCOUNT_FILE=/etc/secrets/firebase.json
FIREBASE_SERVICE_ACCOUNT=

# Optional: emails granted admin-only features (comma separated).
AURAFIX_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# LLM keys (local CLI / tests only — users bring their own in the app)
# ---------------------------------------------------------------------------
# Any one of these lets the CLI and offline tests run. Get a free Gemini key
# at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# GitHub token for local CLI PR creation (users paste their own in the app).
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Hardening knobs (sensible defaults; override only if needed)
# ---------------------------------------------------------------------------
# Allow the "Local path" repo source (reads a directory on the SERVER). Keep
# OFF on any public deployment.
AURAFIX_ALLOW_LOCAL_PATH=false
# AURAFIX_LOCAL_PATH_BASE=/some/safe/base   # confine local paths under here

# Where the embedded vector store writes its cache (outside the web root).
CHROMA_PERSIST_DIR=./chroma_db

# Rate limits (defaults shown): runs per identity, and a global ceiling.
# AURAFIX_RL_RUN_SHORT_MAX=5
# AURAFIX_RL_RUN_SHORT_WINDOW=600
# AURAFIX_RL_RUN_DAY_MAX=40
# AURAFIX_RL_GLOBAL_RUN_MAX=60

# Restrict cross-origin requests to your site (Streamlit reads this env var).
# STREAMLIT_SERVER_CORS_ALLOWED_ORIGINS=https://your-app.onrender.com
